# OpenAI
OPENAI_API_KEY=

# H200 VoxCPM2 SSH tüneli
VOXCPM2_TTS_URL=http://127.0.0.1:18031/tts/stream

# H200 Faster-Whisper SSH tüneli
WHISPER_URL=http://127.0.0.1:18032

# Mikrofon ve STT
ENABLE_STT=true
MIC_SAMPLE_RATE=48000

# VAD
VAD_RMS_THRESHOLD=0.030
VAD_ECHO_GUARD=true
VAD_BARGE_IN_RMS_THRESHOLD=0.10
VAD_PLAYBACK_RMS_THRESHOLD=0.10
VAD_PLAYBACK_ACTIVE_SECONDS=0.0
VAD_ECHO_HANGOVER_SECONDS=0.7
VAD_BARGE_IN_CONFIRM_MS=350

# Gerçek akustik yankı iptali (AEC) — TTS'in hoparlöre gönderdiği
# sesin referans olarak kullanılıp mikrofon sinyalinden çıkarılması.
# AEC_REFERENCE_DELAY_MS: hoparlör->mikrofon akustik + cihaz gecikmesi
# tahmini; gerçek donanımda kalibre edilmesi gerekir (varsayılan
# muhafazakar bir başlangıç noktasıdır).
AEC_ENABLED=true
AEC_REFERENCE_DELAY_MS=180
AEC_FILTER_LENGTH_SAMPLES=4096
